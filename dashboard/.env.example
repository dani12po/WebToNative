# URL project Supabase, contoh: https://nama-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon/public key dari Settings > API di Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Hanya dipakai server-side; jangan pernah dikirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# Kunci acak untuk mengenkripsi koneksi layanan yang disimpan dashboard.
# Gunakan nilai unik minimal 32 karakter pada environment produksi.
WEBTONATIVE_SECRETS_KEY=

# Secret acak minimal 32 karakter untuk hash IP pada rate limit endpoint vault.
# Tidak pernah dikirim ke browser dan bukan Master Password pengguna.
VAULT_RATE_LIMIT_SECRET=

# Secret server-only untuk menandatangani tiket reset vault berdurasi 5 menit.
VAULT_RECOVERY_TOKEN_SECRET=

# Hanya diperlukan bila memilih Prisma untuk akses database server-side.
# Supabase SDK tetap dapat dipakai tanpa Prisma.
DATABASE_URL=

# URL server-side ke binary WebToNative Agent Windows. Binary dibangun dari
# repository core private, lalu diunggah ke storage/CDN terpisah.
WEBTONATIVE_AGENT_DOWNLOAD_URL=

# SHA-256 binary yang sama (huruf kecil). Endpoint dashboard meneruskannya
# ke bootstrap PowerShell untuk verifikasi sebelum agent dijalankan.
WEBTONATIVE_AGENT_SHA256=
