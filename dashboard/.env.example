# URL project Supabase, contoh: https://nama-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon/public key dari Settings > API di Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Hanya dipakai server-side; jangan pernah dikirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# Kunci acak untuk mengenkripsi koneksi layanan yang disimpan dashboard.
# Gunakan nilai unik minimal 32 karakter pada environment produksi.
WEBTONATIVE_SECRETS_KEY=
